    "\n",
    "# np.abs is the absolute value, so we do not care which of the two is larger\n",
    "difference = np.abs(strategy_average - class_average)\n",
    "assert difference < 0.5, \"N = 0 should behave like choosing a candidate at random\"\n",
    "\n",
    "print(\"passed\")"
